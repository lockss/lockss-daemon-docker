#!/bin/sh
# Do not edit the line above. The script must work with
# /bin/sh on Solaris. After any change to this file it must be
# tested on both Linux and Solaris.
if [ "X${LOCKSS_HOME}" != "X" -a -f ${LOCKSS_HOME}/etc/lockss/functions ]
then
    . ${LOCKSS_HOME}/etc/lockss/functions # XXX eliminate LOCKSS_HOME
elif [ -f /etc/lockss/functions ]
then
    . /etc/lockss/functions
elif [ -f ${HOME}/etc/lockss/functions ]
then
    . ${HOME}/etc/lockss/functions
else
    echo "Can't find LOCKSS functions"
    exit 1
fi

DEFAULT_TEST_GROUP=prod

if [ "X${1}" = Xwait ]; then
    WAIT=Y
    shift
fi

if [ "X${USER}" = X ]; then
    echo "USER not set"
    exit 1
fi
set_lockss_user ${USER}
set_variables ${USER}

DAEMON_COUNT=0
for A in ${LOCKSS_USER}
do
    DAEMON_COUNT=`expr ${DAEMON_COUNT} + 1`
done

if [ -f ${LOCKSS_HOME}/etc/lockss/config.$USER.dat ]; then
    CFG_FILE=${LOCKSS_HOME}/etc/lockss/config.$USER.dat
fi
if [ -f ${CFG_FILE} ]; then
    # CFG_FILE should only set environment variables - avoid executing it
    TMP_CFG_FILE=`mktemp /tmp/CFG_FILE_XXXXXX`
    for KEY in `sed -n 's/^\([A-Z0-9_]*\)=.*$/\1/p' <${CFG_FILE}` ; do
        VALUE=`sed -n -e '/\`/d' -e /^${KEY}=/s///p <${CFG_FILE}`
        echo ${KEY}=${VALUE}
    done >${TMP_CFG_FILE}
    . ${TMP_CFG_FILE}
    rm -f ${TMP_CFG_FILE}
else
    echo "${CFG_FILE} missing; run ${CFG_SCRIPT}" >>${LOG_FILE}
    exit 1
fi

# Capture output of 'java -version', extract language version
# and address width (64/32)

OLD_IFS="${IFS}"
IFS=""
JAVA_VERSTR=`${LOCKSS_JAVA_CMD} -version 2>&1`
JAVA_VERSION=`echo "${JAVA_VERSTR}" | head -1 | sed -e 's/.* "\(.*\)"/\1/'`
JAVA_BITS=32
echo "${JAVA_VERSTR}" | egrep -qi '64[- ]?bit' && JAVA_BITS=64 >/dev/null 2>&1
IFS="${OLD_IFS}"

# 64-bit JVM can handle (and requires) much larger heap
case "X${JAVA_BITS}" in
  X64)
    MIN_JAVA_HEAP_IN_MB=1024
    MAX_JAVA_HEAP_IN_MB=12288
    DEFAULT_JAVA_HEAP_IN_MB=4096
    ;;
  X*)
    MIN_JAVA_HEAP_IN_MB=200
    MAX_JAVA_HEAP_IN_MB=1536
    DEFAULT_JAVA_HEAP_IN_MB=500
    ;;
esac

case "X${JAVA_VERSION}" in
X1.8.*|X9.*|X1[012345].*)
    ;;
*)
    echo "Java version is ${JAVA_VERSION}: 8 or higher required" >>${LOG_FILE}
    exit 1
    ;;
esac

# Set LOCKSS_JAVA_HEAP iff it wasn't set in config.dat
if [ "${LOCKSS_JAVA_HEAP}X" = X ] ; then
    set_java_heap
fi

CLASSPATH=/usr/share/lockss/lockss.jar:/usr/share/lockss/lockss-generated.jar:/usr/share/lockss/commons-text-1.11.0.jar:/usr/share/lockss/commons-lang-2.6.jar:/usr/share/lockss/commons-lang3-3.14.0.jar:/usr/share/lockss/commons-collections-3.2.2.jar:/usr/share/lockss/commons-collections4-4.4.jar:/usr/share/lockss/commons-logging-1.2.jar:/usr/share/lockss/commons-cli-1.6.0.jar:/usr/share/lockss/commons-codec-1.16.1.jar:/usr/share/lockss/commons-configuration-1.10.jar:/usr/share/lockss/commons-csv-1.10.0.jar:/usr/share/lockss/commons-compress-1.25.0.jar:/usr/share/lockss/commons-httpclient-3.0-rc4.jar:/usr/share/lockss/commons-io-2.15.1.jar:/usr/share/lockss/commons-jxpath-1.3.jar:/usr/share/lockss/commons-validator-1.8.0.jar:/usr/share/lockss/commons-primitives-1.0.jar:/usr/share/lockss/truezip-kernel-7.5.5.jar:/usr/share/lockss/truezip-file-7.5.5.jar:/usr/share/lockss/truezip-driver-file-7.5.5.jar:/usr/share/lockss/truezip-driver-zip-7.5.5.jar:/usr/share/lockss/truezip-driver-tar-7.5.5.jar:/usr/share/lockss/truezip-swing-7.5.5.jar:/usr/share/lockss/javagnutar.jar:/usr/share/lockss/log4j-api-2.24.1.jar:/usr/share/lockss/log4j-core-2.24.1.jar:/usr/share/lockss/log4j-1.2-api-2.24.1.jar:/usr/share/lockss/concurrent.jar:/usr/share/lockss/jetty-5.1.5L.jar:/usr/share/lockss/javax.servlet.jar:/usr/share/lockss/ziplet-2.4.1.jar:/usr/share/lockss/js-engine.jar:/usr/share/lockss/script.jar:/usr/share/lockss/rhino.jar:/usr/share/lockss/derby.jar:/usr/share/lockss/derbyclient.jar:/usr/share/lockss/derbynet.jar:/usr/share/lockss/postgresql-42.6.0.jar:/usr/share/lockss/mysql-connector-j-8.0.31.jar:/usr/share/lockss/javamail-mailapi-1.3.2.jar:/usr/share/lockss/activation-1.0.2.jar:/usr/share/lockss/castor-0.9.4.1-xml.jar:/usr/share/lockss/xercesImpl-2.12.1.jar:/usr/share/lockss/xml-apis-1.4.01.jar:/usr/share/lockss/JimiProClasses.jar:/usr/share/lockss/jakarta-oro-2.0.8.jar:/usr/share/lockss/htmlparser-1.6p.jar:/usr/share/lockss/jsoup-1.16.2.jar:/usr/share/lockss/marc4j-2.9.5.jar:/usr/share/lockss/jonix-2023-10.jar:/usr/share/lockss/jonix-common-2023-10.jar:/usr/share/lockss/jonix-xml-2023-10.jar:/usr/share/lockss/jonix-onix2-2023-10.jar:/usr/share/lockss/jonix-onix3-2023-10.jar:/usr/share/lockss/apiviz-1.3.1.jar:/usr/share/lockss/jbibtex-1.0.20.jar:/usr/share/lockss/rdf-api-2001-01-19.jar:/usr/share/lockss/xstream-1.4.21.jar:/usr/share/lockss/pdfbox-1.8.17.jar:/usr/share/lockss/fontbox-1.8.17.jar:/usr/share/lockss/jempbox-1.8.17.jar:/usr/share/lockss/bcprov-jdk18on-1.76.jar:/usr/share/lockss/bcmail-jdk18on-1.76.jar:/usr/share/lockss/icu4j-74.1.jar:/usr/share/lockss/icu4j-charset-74.1.jar:/usr/share/lockss/icu4j-localespi-74.1.jar:/usr/share/lockss/PDFBox-0.7.3.jar:/usr/share/lockss/FontBox-0.1.0-dev.jar:/usr/share/lockss/harvester2-0.1.12-p1.jar:/usr/share/lockss/xalan-2.7.2.jar:/usr/share/lockss/heritrix-commons-3.1.0-p1.jar:/usr/share/lockss/fastutil-5.0.7.jar:/usr/share/lockss/guava-r08.jar:/usr/share/lockss/commons-beanutils-1.9.4.jar:/usr/share/lockss/gettext-commons-0.9.6.jar:/usr/share/lockss/aopalliance-1.0.jar:/usr/share/lockss/asm-3.3.1.jar:/usr/share/lockss/cxf-2.6.2.jar:/usr/share/lockss/FastInfoset-1.2.9.jar:/usr/share/lockss/jaxb-impl-2.2.5.jar:/usr/share/lockss/jaxb-xjc-2.2.5.jar:/usr/share/lockss/mimepull-1.7.jar:/usr/share/lockss/neethi-3.0.2.jar:/usr/share/lockss/spring-aop-3.0.7.RELEASE.jar:/usr/share/lockss/spring-asm-3.0.7.RELEASE.jar:/usr/share/lockss/spring-beans-3.0.7.RELEASE.jar:/usr/share/lockss/spring-context-3.0.7.RELEASE.jar:/usr/share/lockss/spring-core-3.0.7.RELEASE.jar:/usr/share/lockss/spring-expression-3.0.7.RELEASE.jar:/usr/share/lockss/spring-web-3.0.7.RELEASE.jar:/usr/share/lockss/velocity-1.7.jar:/usr/share/lockss/wsdl4j-1.6.2.jar:/usr/share/lockss/xmlschema-core-2.0.3.jar:/usr/share/lockss/JoSQL-2.2.jar:/usr/share/lockss/gentlyWEB-utils-1.1.jar:/usr/share/lockss/gnu-getopt-1.0.13.jar:/usr/share/lockss/jackson-annotations-2.10.5.jar:/usr/share/lockss/jackson-core-2.10.5.jar:/usr/share/lockss/jackson-databind-2.10.5.1.jar:/usr/share/lockss/lucene-analyzers-common-8.9.0.jar:/usr/share/lockss/lucene-core-8.9.0.jar:/usr/share/lockss/okhttp-4.9.3.jar:/usr/share/lockss/logging-interceptor-4.9.3.jar:/usr/share/lockss/okio-2.8.0.jar:/usr/share/lockss/kotlin-stdlib-1.4.10.jar:/usr/share/lockss/gson-2.8.6.jar:/usr/share/lockss/gson-fire-1.8.4.jar:/usr/share/lockss/swagger-annotations-1.5.24.jar:/usr/share/lockss/jsr305-3.0.2.jar:/usr/share/lockss/json-path-2.8.0.jar:/usr/share/lockss/antlr-runtime-4.9.3.jar:/usr/share/lockss/xoai-common-4.2.0.jar:/usr/share/lockss/xoai-service-provider-4.2.0-p1.jar:/usr/share/lockss/xml-io-1.0.3-p2.jar:/usr/share/lockss/httpcore-4.3.2.jar:/usr/share/lockss/hamcrest-all-1.3.jar:/usr/share/lockss/stax2-api-3.0.4.jar:/usr/share/lockss/woodstox-core-asl-4.4.1.jar:/usr/share/lockss/test-support-1.0.4.jar:/usr/share/lockss/httpclient-4.3.1.jar:/usr/share/lockss/commons-digester-commons-digester.jar:/usr/share/lockss/commons-fileupload-commons-fileupload.jar:/usr/share/lockss/esapi-2.0GA.jar:/usr/share/lockss/joda-time-joda-time.jar:/usr/share/lockss/oiosaml.java-21188-PATCHED.jar:/usr/share/lockss/opensaml-2.5.1.jar:/usr/share/lockss/openws-1.4.2.jar:/usr/share/lockss/org.apache.santuario-xmlsec.jar:/usr/share/lockss/org.bouncycastle-bcpkix-jdk15on.jar:/usr/share/lockss/org.fishwife-jrugged-core.jar:/usr/share/lockss/slf4j-api-1.7.25.jar:/usr/share/lockss/xalan-serializer-2.7.2.jar:/usr/share/lockss/xml-resolver-1.2.jar:/usr/share/lockss/xmltooling-1.3.2.jar:/usr/share/lockss/jcabi-aspects-1.0-SNAPSHOT-jar-with-dependencies.jar
DAEMON_CLASS=org.lockss.app.LockssDaemon
if [ "X${LOCKSS_JAVA_SWITCHES}" = "X" ]; then
    LOCKSS_JAVA_SWITCHES="-server -Xmx${LOCKSS_JAVA_HEAP:-500m} -Dsun.net.inetaddr.ttl=3600 -showversion -Dderby.drda.traceAll=true"
fi
# if LOCKSS_PROPS_URL starts with "-" it is assumed to be the of the form
#    -p <url1> [-p <url2> ...]
case "X${LOCKSS_PROPS_URL}" in
X-p*)
    DAEMON_ARGS="${LOCKSS_PROPS_URL} -p ${LOCAL_TXT}"
    ;;
*)
    DAEMON_ARGS="-p ${LOCKSS_PROPS_URL} -p ${LOCAL_TXT}"
    ;;
esac
if [ "X${LOCKSS_SSL_CONFIG}" != "X" -a -s ${LOCKSS_SSL_CONFIG} ]; then
    DAEMON_ARGS="${DAEMON_ARGS} -p ${LOCKSS_SSL_CONFIG}"
fi
if [ "X${LOCKSS_TEST_GROUP}" != "X" ]; then
    DAEMON_ARGS="-g ${LOCKSS_TEST_GROUP} ${DAEMON_ARGS}"
else
    DAEMON_ARGS="-g ${DEFAULT_TEST_GROUP} ${DAEMON_ARGS}"
fi
if [ "X${LOCKSS_EXTRA_DAEMON_ARGS}" != X ]; then
    DAEMON_ARGS="${DAEMON_ARGS} ${LOCKSS_EXTRA_DAEMON_ARGS}"
fi

if [ "X${LOCKSS_EXTERNAL_IPADDR}" != X ]; then
    LOCKSS_V3_IDENTITY="TCP:[${LOCKSS_EXTERNAL_IPADDR}]:${LOCKSS_V3_PORT}"
else
    LOCKSS_V3_IDENTITY="TCP:[${LOCKSS_IPADDR}]:${LOCKSS_V3_PORT}"
fi
#LOCKSS_JAVA_SWITCHES="${LOCKSS_JAVA_SWITCHES} -Dorg.lockss.defaultLogLevel=DEBUG3"
case ${LOCKSS_CLEAR_TMPDIR} in
yes | Yes | YES )
    case "X${LOCKSS_TMPDIR}" in
    X | X/tmp | X/var/tmp )
        # don't clear if unset, or /tmp or /var/tmp
        ;;
    * )
        echo "Clearing ${LOCKSS_TMPDIR}" >> ${LOG_FILE}
        (cd ${LOCKSS_TMPDIR} && rm -rf *) >> ${LOG_FILE} # XXX delete tree from unzip
        ;;
    esac
    ;;
esac
cat >${LOCAL_TXT} <<EOF
org.lockss.platform.localIPAddress=${LOCKSS_IPADDR}
org.lockss.platform.v3.identity=${LOCKSS_V3_IDENTITY}
org.lockss.platform.diskSpacePaths=${LOCKSS_DISK_PATHS}
org.lockss.platform.version=Linux RPM-1
org.lockss.platform.sysadminemail=${LOCKSS_EMAIL}
org.lockss.platform.accesssubnet=${LOCKSS_ACCESS_SUBNET}
org.lockss.platform.smtphost=${LOCKSS_MAILHUB}
org.lockss.platform.smtpport=25
org.lockss.platform.tmpDir=${LOCKSS_TMPDIR:-/tmp}
org.lockss.platform.logdirectory=${LOCKSS_HOME}/var/log/${LOCKSS_USER}
org.lockss.platform.logfile=daemon
org.lockss.log.targets=org.lockss.util.FileTarget
org.lockss.platform.fqdn=${LOCKSS_HOSTNAME}
org.lockss.platform.ui.username=${LOCKSS_ADMIN_USER}
org.lockss.platform.ui.password=${LOCKSS_ADMIN_PASSWD}
org.lockss.proxy.port=${LOCKSS_PROXY_PORT}
org.lockss.ui.port=${LOCKSS_UI_PORT}
org.lockss.platform.watchdog.file=${WATCHDOG}
org.lockss.platform.watchdog.interval=${WATCHDOG_SECS}s
org.lockss.platform.propsProxy=${LOCKSS_PROPS_PROXY}
org.lockss.config.serverAuthKeystore=${LOCKSS_PROPS_SERVER_AUTHENTICATE_KEYSTORE}
org.lockss.platform.remoteConfigFailover=${LOCKSS_CONFIG_FAILOVER_ENABLE}
org.lockss.platform.remoteConfigFailoverMaxAge=${LOCKSS_CONFIG_FAILOVER_MAX_AGE}
EOF
cd ${LOCKSS_HOME}
echo "Starting daemon at `date`" >> ${LOG_FILE}
${LOCKSS_JAVA_CMD} ${LOCKSS_JAVA_SWITCHES} -classpath ${CLASSPATH} ${DAEMON_CLASS} ${DAEMON_ARGS} >> "$LOG_FILE" 2>&1 &
echo $! >${PID_FILE}
if [ X${WAIT} != X ]; then
    wait `cat ${PID_FILE}`
fi
# NB - no commands below here
